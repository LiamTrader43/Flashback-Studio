<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app test (see ../README.md): WindowsAppTest.cs, with the
       app's own clip reader, compactor, input display and export. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="WindowsAppTest.cs" />
    <Compile Include="..\..\windows-app\FlbClip.cs" />
    <Compile Include="..\..\windows-app\FlbCompactor.cs" />
    <Compile Include="..\..\windows-app\InputOverlay.cs" />
    <Compile Include="..\..\windows-app\Converter.cs" />
  </ItemGroup>

</Project>
